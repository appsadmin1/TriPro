<resources>
    <!-- This XML theme only controls the system window before setContent{} runs.
         All real theming (colors, type, shapes) lives in ui/theme/*.kt and is
         generated from DESIGN.md's TriPro tokens. -->
    <style name="Theme.TriPro.Starting" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/surface</item>
        <item name="android:statusBarColor">@color/surface</item>
        <item name="android:navigationBarColor">@color/surface</item>
    </style>

    <style name="Theme.TriPro.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/surface</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.TriPro.Starting</item>
    </style>
</resources>
